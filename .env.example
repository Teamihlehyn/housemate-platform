# Copy to .env and fill in. See ENVIRONMENTS.md for the full picture.

# Which environment this process is. One of: development | staging | beta.
# Drives demo features: beta disables the demo login sink and seeded personas.
APP_ENV="development"
# Same value, exposed to the browser (gates demo UI like persona quick-login).
NEXT_PUBLIC_APP_ENV="development"

# Postgres connection used by the app at runtime.
# Neon: use the POOLED connection string (host contains "-pooler"), ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Direct (unpooled) connection used only for `prisma migrate`.
# Neon: use the NON-pooler connection string. Locally this can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Demo login sink: when "true" (dev/staging) the 6-digit code is returned in the
# API response and shown on-screen. ALWAYS off in beta regardless of this value.
DEMO_MODE="true"

# --- Email delivery (required in beta; unused when DEMO_MODE is on) ---
# Resend API key and a verified sender address.
RESEND_API_KEY=""
EMAIL_FROM="Housemate <login@your-verified-domain>"
