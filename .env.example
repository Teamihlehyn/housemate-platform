# Copy to .env and fill in.

# Postgres connection used by the app at runtime.
# On Neon, use the POOLED connection string (host contains "-pooler"), with ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Direct (unpooled) connection used only for `prisma db push` / migrations.
# On Neon, use the NON-pooler connection string. Locally this can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Keeps the sign-in code visible in the on-screen "demo sink" (no real email needed).
# Set to "false" only if you wire up a real email provider.
DEMO_MODE="true"
