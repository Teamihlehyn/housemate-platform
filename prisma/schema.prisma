// Peabudy (formerly Housemate) — Prisma schema
// SQLite for zero-config local dev. JSON is stored as stringified text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection used for migrations / `prisma db push`.
  // On Neon set this to the non-pooler connection string; locally it can match DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Accounts & auth
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  Boolean  @default(false)
  phone          String?
  phoneVerified  Boolean  @default(false)
  displayName    String
  // applicant: applied through /join, not yet activated (approval-first sign-up, ENG-39).
  accountStatus  String   @default("active") // applicant|active|restricted|suspended|deletion_pending|deleted
  adultEligible  Boolean  @default(false)
  locale         String   @default("en-GB")
  role           String   @default("member") // member|verifier|moderator|admin
  lastActiveDay  DateTime @default(now())
  privacyConsentAt      DateTime?
  privacyConsentVersion String?
  // Survey emails (ENG-29): opt-in consent only, never pre-ticked. Eligible to receive one
  // only while surveyOptIn is true and unsubscribedAt is null.
  surveyOptIn        Boolean   @default(false)
  surveyOptInAt      DateTime?
  surveyOptInVersion String?
  unsubscribedAt     DateTime?
  // User testing: each tester gets a private world of sample housemates.
  // Users in a world only see each other; users outside never see them.
  sandboxWorldId String?
  isDemoBot      Boolean  @default(false) // sample housemate that responds automatically
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        Profile?
  search         Search?
  sessions       Session[]
  checks         VerificationCheck[]
  scoreSnapshots ScoreSnapshot[]
  staffCredential StaffCredential?

  @@index([sandboxWorldId])
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // member: the whole app. application: an applicant's session, limited to the /join
  // allow-list (ENG-39); every other API route answers 404.
  scope     String   @default("member")
  createdAt DateTime @default(now())
}

model AuthCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  inviteId  String?  // retired (D15 invite-gated sign-up); kept for old rows
  // Privacy notice version agreed at /join step 1 (applications/start), so verify can record it.
  consentVersion String?
  // null: user sign-in, /join and activation. "staff": the back-office second step (ENG-47),
  // bound to the password step by pendingHash (SHA-256 of the hm_staff_pending cookie).
  scope          String?
  pendingHash    String?
  // A never-sent code for an address that may not sign in (HM-35, ENG-47): never accepted.
  decoy          Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Profile, search, preferences
// ---------------------------------------------------------------------------

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey           String?  // find_together|candidate_home|existing_room
  bio               String?
  avatarInitials    String?
  publicationStatus String   @default("draft") // draft|published
  publishedAt       DateTime?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Search {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String   @default("draft") // draft|active|paused|housed|archived
  cityId             String?
  currency           String?  // GBP|NGN
  rentMinMinor       Int?
  rentMaxMinor       Int?
  rentPeriod         String?  // month|year
  upfrontMinor       Int?
  locationDetail     String?  // private: preferred postcode/address (owner-only, never on public card)
  moveMode           String?  // exact|range|undecided
  earliestDate       String?  // YYYY-MM-DD
  latestDate         String?
  preferredDate      String?
  arrivalDate        String?
  stayMinMonths      Int?
  stayMaxMonths      Int?
  // Private, matching only — never shown on the public profile.
  gender             String?  // woman|man|non_binary|prefer_not_to_say
  genderPreference   String   @default("[\"woman\",\"man\",\"non_binary\"]") // JSON array: who they're open to living with
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  areas       SearchArea[]
  preferences PreferenceAnswer[]
  versions    SearchVersion[]
}

model SearchArea {
  id       String @id @default(cuid())
  searchId String
  search   Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  areaId   String

  @@unique([searchId, areaId])
}

model PreferenceAnswer {
  id             String @id @default(cuid())
  searchId       String
  search         Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  dimension      String // cleaning|quiet|guests|smoking|pets|social
  ownAnswer      String
  acceptedValues String // JSON array of accepted values

  @@unique([searchId, dimension])
}

model SearchVersion {
  id        String   @id @default(cuid())
  searchId  String
  search    Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  versionNo Int
  snapshot  String   // JSON snapshot of matching-relevant fields
  purpose   String   @default("edit")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Verification & credibility
// ---------------------------------------------------------------------------

model VerificationCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // identity|email|phone|reference|additional
  status    String   @default("verified") // simplified for slice
  points    Int      @default(0)
  checkedAt DateTime @default(now())
  validUntil DateTime?

  @@unique([userId, category])
}

model ScoreSnapshot {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Int
  componentJson  String
  rubricVersion  String   @default("v1")
  calculatedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Introductions & chat
// ---------------------------------------------------------------------------

model Introduction {
  id        String   @id @default(cuid())
  lowUserId String
  highUserId String
  senderId  String
  state     String   @default("pending") // pending|accepted|declined|withdrawn|expired
  text      String
  reasonCode String?
  expiresAt DateTime
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation?

  @@unique([lowUserId, highUserId])
}

model Conversation {
  id             String   @id @default(cuid())
  introductionId String   @unique
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)
  userAId        String
  userBId        String
  status         String   @default("open") // open|closed
  lastSequence   Int      @default(0)
  createdAt      DateTime @default(now())

  messages Message[]
  meetings Meeting[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  clientMessageId String
  serverSequence  Int
  body            String
  state           String   @default("sent")
  sentAt          DateTime @default(now())

  @@unique([conversationId, serverSequence])
  @@unique([senderId, clientMessageId])
}

model Meeting {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposedBy     String
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  state          String   @default("proposed") // proposed|accepted|declined|cancelled|completed
  version        Int      @default(1)
  createdAt      DateTime @default(now())
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ---------------------------------------------------------------------------
// Households
// ---------------------------------------------------------------------------

model Household {
  id                 String   @id @default(cuid())
  state              String   @default("proposed") // proposed|active|completed|closed|declined|expired
  derivedStage       String   @default("planning") // planning|viewing|application|move_in_pending|needs_reagreement
  introductionId     String?
  currentPlanVersion Int      @default(1)
  version            Int      @default(1)
  formedAt           DateTime?
  closedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships Membership[]
  plans       HouseholdPlan[]
  shortlist   ShortlistItem[]
  viewings    Viewing[]
  handoffs    Handoff[]
  moveIns     MoveInConfirmation[]
}

model Membership {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  state       String   @default("active") // active|left
  joinedAt    DateTime @default(now())
  leftAt      DateTime?

  @@unique([householdId, userId])
}

model HouseholdPlan {
  id            String   @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  versionNo     Int
  earliestDate  String
  latestDate    String
  contributions String   // JSON: { userId: monthlyMinorAmount } — monthly equivalent rent per person
  currency      String
  stayMin       Int
  stayMax       Int
  noticePeriodWeeks Int    @default(4)       // notice either member gives before leaving
  billsSplit        String @default("equal") // equal|same_as_rent
  notes             String?                  // other things agreed in writing (max 500)
  propertyId    String?
  changeReason  String?
  createdAt     DateTime @default(now())

  acceptances PlanAcceptance[]

  @@unique([householdId, versionNo])
}

model PlanAcceptance {
  id         String   @id @default(cuid())
  planId     String
  plan       HouseholdPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId     String
  acceptedAt DateTime @default(now())
  revokedAt  DateTime?

  @@unique([planId, userId])
}

// ---------------------------------------------------------------------------
// Properties & downstream housing workflow
// ---------------------------------------------------------------------------

model Property {
  id             String   @id @default(cuid())
  sourceType     String   // sample_partner_feed|user_link|member_room_offer
  cityId         String
  areaId         String
  title          String
  description    String
  sourceUrl      String?
  bedroomCount   Int      @default(1)
  contractType   String   @default("room") // room|whole_home
  rentMinor      Int
  currency       String
  rentPeriod     String
  includedCosts  String?  // JSON
  upfrontItems   String?  // JSON
  depositMinor   Int?
  sharersAllowed Boolean  @default(true)
  startEarliest  String?
  startLatest    String?
  stayMin        Int?
  stayMax        Int?
  state          String   @default("available") // available|withdrawn
  lastConfirmedAt DateTime @default(now())
  createdAt      DateTime @default(now())
}

model ShortlistItem {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  propertyId  String?
  url         String?
  title       String
  area        String?
  priceNote   String?
  notes       String?
  state       String   @default("active") // active|archived
  createdAt   DateTime @default(now())

  votes ShortlistVote[]
}

model ShortlistVote {
  id       String   @id @default(cuid())
  itemId   String
  item     ShortlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId   String
  decision String // interested|not_interested|undecided

  @@unique([itemId, userId])
}

model Viewing {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  shortlistItemId String
  proposedBy  String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  state       String   @default("proposed") // proposed|awaiting_partner|confirmed|rejected|cancelled|completed|no_show|disputed
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  outcomes ViewingOutcome[]
}

model ViewingOutcome {
  id        String   @id @default(cuid())
  viewingId String
  viewing   Viewing  @relation(fields: [viewingId], references: [id], onDelete: Cascade)
  userId    String
  response  String   // completed|no_show|cancelled
  recordedAt DateTime @default(now())

  @@unique([viewingId, userId])
}

model Handoff {
  id             String   @id @default(cuid())
  householdId    String
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  propertyId     String?
  planVersion    Int
  partnerId      String   @default("mock_partner_gb")
  state          String   @default("draft") // draft|awaiting_member_consent|submitted|needs_input|accepted|rejected|withdrawn
  version        Int      @default(1)
  decision       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  acceptances HandoffAcceptance[]
}

model HandoffAcceptance {
  id          String   @id @default(cuid())
  handoffId   String
  handoff     Handoff  @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  userId      String
  payloadHash String
  acceptedAt  DateTime @default(now())

  @@unique([handoffId, userId])
}

model MoveInConfirmation {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  actualDate  String
  response    String   // moved_in|not_moved|disputed
  source      String   @default("self_report_demo")
  recordedAt  DateTime @default(now())

  @@unique([householdId, userId])
}

// ---------------------------------------------------------------------------
// Notifications, audit, outbox
// ---------------------------------------------------------------------------

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  targetUserId   String
  category       String   // scam_money_request|harassment|identity_issue|unsafe_property|threat|other
  description    String
  conversationId String?
  status         String   @default("open") // open|triaged|resolved
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
}

// Application retention (R7): after a declined application's answers are purged, only a hashed
// email and the reapply date are kept, so the 30-day reapply rule still holds. Deleted once the
// date passes (or the person applies again).
model ApplicantTombstone {
  emailHash    String   @id // lib/auth.ts hashEmailKey (salted, truncated SHA-256)
  reapplyAfter DateTime
  createdAt    DateTime @default(now())

  @@index([reapplyAfter])
}

// Invite-only sign-up (D15). RETIRED by approval-first sign-up: read-only, no new rows.
model AccessRequest {
  id             String    @id @default(cuid())
  name           String
  email          String    // lower-cased
  city           String    // CITIES id
  area           String    // area id, or "not_sure"
  moveInMonth    String    // YYYY-MM, or "not_sure"
  howHeard       String?
  note           String?   // ≤ 300 chars
  status         String    @default("pending") // pending|invited|declined
  consentVersion String    // privacy notice version agreed when asking
  createdAt      DateTime  @default(now())
  reviewedBy     String?   // staff user id
  reviewedAt     DateTime?
  declineReason  String?

  @@index([email, status])
  @@index([status, createdAt])
}

// A single-use sign-up invite. Only the SHA-256 of the code is stored.
model Invite {
  id              String    @id @default(cuid())
  codeHash        String    @unique
  email           String?   // when set, only this address can use it
  accessRequestId String?   // retired (D15)
  applicationId   String?   // approval-first: the activation code for this application
  createdBy       String    // staff user id
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  revokedAt       DateTime? // staff revoked it, or a newer invite replaced it
  createdAt       DateTime  @default(now())

  @@index([accessRequestId])
  @@index([applicationId])
  @@index([email])
}

// Back-office sign-in (ENG-47): password + emailed code. Only allowlisted staff addresses
// (lib/staff.ts) ever get a credential. scrypt hash, never the password.
model StaffCredential {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash  String    // scrypt$N$r$p$salt$hash (base64)
  passwordSetAt DateTime
  // Attempt limits live in the audit log (lib/staffLimits.ts, HM-43/45), not here.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One-time link to set (or reset) a back-office password. Only the SHA-256 is stored; 30 min;
// a new link invalidates earlier ones. Bound to the email (the account may not exist yet).
model StaffSetupToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Approval-first sign-up (ENG-39). One per applicant; the answers live in the person's own
// Profile/Search rows. Staff review here; approval creates an activation Invite.
model Application {
  id                 String    @id @default(cuid())
  userId             String    @unique
  // draft|submitted|in_review|call_booked|approved|declined|waitlisted|withdrawn
  status             String    @default("draft")
  submittedAt        DateTime?
  callAt             DateTime? // ID call time, when staff booked one
  reviewedBy         String?   // staff user id
  reviewedAt         DateTime?
  idCheckMethod      String?   // video | provider:didit
  idCheckAt          DateTime?
  // Staff-only: the reviewer's own words when approving an account they're connected to (their
  // own test account, ENG-46). Never in the audit log (only a flag and its length there).
  ownAccount         Boolean   @default(false)
  relationshipNote   String?
  declineReason      String?   // not_genuine|agent_or_landlord|id_failed|no_show|duplicate|other
  reapplyAfter       DateTime?
  activationInviteId String?
  statusTokenHash    String?   @unique // SHA-256 of the E1 magic-link token
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, submittedAt])
}

model TesterFeedback {
  id        String   @id @default(cuid())
  userId    String?
  testerId  String?  // anonymous per-browser ID, also tagged in Clarity
  source    String?  // recruitment channel from ?source=
  page      String
  rating    Int?     // 1–5
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  eventName   String
  title       String
  body        String
  channel     String   @default("in_app")
  readAt      DateTime?
  createdAt   DateTime @default(now())
}

model AuditEvent {
  id            String   @id @default(cuid())
  eventType     String
  actorType     String   // user|staff|service|job
  actorId       String?
  subjectId     String?
  resourceType  String
  resourceId    String
  action        String
  outcome       String   // allowed|denied|failed
  reasonCode    String?
  safeBefore    String?
  safeAfter     String?
  versionBefore Int?
  versionAfter  Int?
  requestId     String?
  correlationId String?
  occurredAt    DateTime @default(now())

  // Sign-in code rate limits count recent rows by type, IP bucket and action (HM-08, HM-24).
  @@index([eventType, occurredAt])
  @@index([eventType, resourceId, occurredAt])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  eventName     String
  payload       String
  status        String   @default("pending") // pending|delivered|dead_letter
  attempts      Int      @default(0)
  correlationId String?
  createdAt     DateTime @default(now())
  deliveredAt   DateTime?
}

model IdempotencyKey {
  key          String   @id
  actorId      String
  route        String
  requestHash  String
  responseJson String
  createdAt    DateTime @default(now())
}
